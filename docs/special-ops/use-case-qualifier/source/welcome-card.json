{
  "type": "AdaptiveCard",
  "$schema": "https://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "bleed": true,
      "backgroundImage": {
        "url": "https://placehold.co/1200x120/0078D4/0078D4.png",
        "fillMode": "RepeatHorizontally"
      },
      "items": [
        {
          "type": "Image",
          "url": "https://placehold.co/200x48/0078D4/ffffff?text=Your+Logo",
          "height": "48px",
          "horizontalAlignment": "Left",
          "altText": "Your organization logo"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "🧭 AI Use Case Qualifier",
      "weight": "Bolder",
      "size": "ExtraLarge",
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "text": "I help you test whether your AI or Copilot idea is worth building. I'll ask 6-8 short questions covering Persona, Pain, Process, and Payback - then score your idea out of 25. If it scores 15 or higher, I'll draft a qualification email from your own Outlook for your review before sending.",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "**To start:** describe your AI or Copilot use case in one or two sentences.",
      "wrap": true,
      "spacing": "Medium"
    }
  ]
}
